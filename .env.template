# ─── Environment ──────────────────────────────────────────────────────────────
NODE_ENV=development
WEBSITE_URL=http://localhost:4200
APPLICATION_ID=

# ─── Terminal 3 SDK (REQUIRED) ────────────────────────────────────────────────
# Your agent's secp256k1 private key (hex, no 0x prefix)
# Generate: node -e "const {randomBytes}=require('crypto'); console.log(randomBytes(32).toString('hex'))"
T3N_AGENT_PRIVATE_KEY=

# T3 Testnet RPC node
T3N_NODE_URL=https://cn-api.sg.testnet.t3n.terminal3.io

# Tenant script namespace (choose a unique name for your agent)
T3N_TENANT_SCRIPT_NAME=medagent-health

# ─── Database (Turso/libSQL) ───────────────────────────────────────────────────
# Local dev: use file:./dev.db
# Production: get from https://turso.tech
DATABASE_URL=file:./dev.db
DATABASE_AUTH_TOKEN=

# ─── Better Auth ──────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=

# ─── AI Gateway (optional — for LLM-powered symptom analysis) ─────────────────
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=

# ─── Payments / Tracking (optional) ──────────────────────────────────────────
AUTUMN_SECRET_KEY=
